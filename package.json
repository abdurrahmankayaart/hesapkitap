{
  "name": "hesap-kitap",
  "version": "3.5.0",
  "private": true,
  "description": "Hesap Kitap: aylık gelir ve gider takibi",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "test": "node tests/e2e/run-all.js",
    "serve": "python3 -m http.server 8000",
    "icons": "node scripts/make-icons.js",
    "store-shots": "node scripts/store-screenshots.js",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "playwright": "1.56.1"
  }
}
